<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Causalia.Kafka</AssemblyName>
    <RootNamespace>Causalia.Kafka</RootNamespace>
    <PackageId>Causalia.Kafka</PackageId>
    <Description>Deterministic Kafka broker and consumer-group simulation for Causalia.</Description>
    <PackageTags>testing;deterministic;simulation;kafka;consumer-groups;offsets;rebalance;distributed-systems</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Causalia/Causalia.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../SCENARIOS.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
