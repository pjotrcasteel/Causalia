<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Causalia.RabbitMQ</AssemblyName>
    <RootNamespace>Causalia.RabbitMQ</RootNamespace>
    <PackageId>Causalia.RabbitMQ</PackageId>
    <Description>Deterministic RabbitMQ exchange, queue and acknowledgement simulation for Causalia.</Description>
    <PackageTags>testing;deterministic;simulation;rabbitmq;amqp;ack;nack;prefetch;distributed-systems</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Causalia/Causalia.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../SCENARIOS.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
