<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Causalia.Load</AssemblyName>
    <RootNamespace>Causalia.Load</RootNamespace>
    <PackageId>Causalia.Load</PackageId>
    <Description>Deterministic simulated load generation for Causalia.</Description>
    <PackageTags>testing;deterministic;simulation;load;concurrency;distributed-systems</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Causalia/Causalia.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../SCENARIOS.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Causalia.Load.Tests" />
  </ItemGroup>
</Project>
