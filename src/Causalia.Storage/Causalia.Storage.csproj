<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Causalia.Storage</AssemblyName>
    <RootNamespace>Causalia.Storage</RootNamespace>
    <PackageId>Causalia.Storage</PackageId>
    <Description>Deterministic durable storage simulation for Causalia.</Description>
    <PackageTags>testing;deterministic;simulation;storage;database;fault-injection;distributed-systems</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Causalia/Causalia.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../SCENARIOS.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Causalia.Storage.Tests" />
    <InternalsVisibleTo Include="Causalia.EntityFrameworkCore" />
  </ItemGroup>
</Project>
